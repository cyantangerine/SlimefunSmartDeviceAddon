# ============================================================
# SlimefunSmartDeviceAddon · deploy.ps1 部署配置模板
# ------------------------------------------------------------
# 使用方式：
#   1. 复制本文件为同目录下的 .env
#   2. 按本机实际情况修改下面的值
#   .env 已在 .gitignore 中忽略，不会被提交到仓库。
#
# 优先级：命令行参数（如 -ServerDir） > 本文件里的环境变量 > 脚本内置默认值
# 留空的值会退回脚本内置默认值或自动探测。
# ============================================================

# 项目根目录（含 pom.xml）。留空 = 使用 deploy.ps1 所在目录。
DEPLOY_PROJECT_DIR=

# Folia 服务器目录（含 plugins\ 子目录与 start.bat）。必填。
DEPLOY_SERVER_DIR=C:\path\to\your\mcserver\folia

# 用于编译的 JDK 21 目录（脚本会临时把进程的 JAVA_HOME 指向这里）。
DEPLOY_JAVA_HOME=C:\Program Files\Java\jdk-21

# mvn.cmd 完整路径。留空 = 依次尝试 PATH、IDEA 内置 Maven、Maven wrapper。
DEPLOY_MAVEN_CMD=

# 本地 Slimefun fork 的 jar 路径（仅当使用 -DeploySlimefun 时才有意义）。
# 留空 = 项目同级目录下 Slimefun4\build\libs\Slimefun-DEV-SNAPSHOT.jar
DEPLOY_SLIMEFUN_JAR=

# 停服等待超时（秒），给 JVM 保存世界的时间。
DEPLOY_STOP_TIMEOUT=45

# 启动等待超时（秒），等待 server-port 开始监听的最长时间。
DEPLOY_START_TIMEOUT=150
